{
  "manifest_version": 2,
  "name": "My Homies for X",
  "version": "0.2.0",
  "description": "Marks timeline authors when X explicitly reports they follow you.",
  "browser_specific_settings": {"gecko": {"id": "myhomies@local.example", "strict_min_version": "109.0"}},
  "permissions": ["storage", "webRequest", "webRequestBlocking", "https://x.com/*"],
  "background": {"scripts": ["relationships.js", "background.js"], "persistent": true},
  "content_scripts": [{"matches": ["https://x.com/*"], "js": ["content.js"], "css": ["content.css"]}],
  "browser_action": {"default_title": "My Homies", "default_popup": "popup.html"}
}
